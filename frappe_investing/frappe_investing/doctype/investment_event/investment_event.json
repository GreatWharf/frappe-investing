    },
    {
      "fieldname": "fx",
      "label": "Fx",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "target_currency",
      "label": "Target Currency",
      "fieldtype": "Link",
      "options": "Currency"
    },
    {
      "fieldname": "target_amount",
      "label": "Target Amount",
      "fieldtype": "Data"
    },
    {
      "fieldname": "provenance",
      "label": "Provenance",
      "fieldtype": "Section Break"
    },
    {
