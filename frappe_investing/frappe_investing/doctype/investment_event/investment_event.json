      "role": "Investment Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "delete": 1,
      "cancel": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
