{
  "doctype": "DocType",
  "name": "Investment Event",
  "module": "Investing",
  "autoname": "hash",
  "engine": "InnoDB",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 1,
  "fields": [
    {
      "fieldname": "event_type",
      "label": "Event Type",
      "fieldtype": "Select",
      "options": "Buy\nSell\nDividend\nCoupon\nInterest\nFee\nDeposit\nWithdrawal\nTransfer In\nTransfer Out\nSplit\nReverse Split\nStock Dividend\nSpin-off\nCash-in-lieu\nRedemption\nFX Conversion",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "posting_date",
      "label": "Posting Date",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "account",
      "label": "Account",
      "fieldtype": "Link",
      "options": "Investment Account",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "security",
      "label": "Security",
      "fieldtype": "Link",
      "options": "Security"
    },
    {
      "fieldname": "amounts",
