      "hidden": 1
    },
    {
      "fieldname": "reversal_of",
      "label": "Reversal Of",
      "fieldtype": "Link",
      "options": "Investment Event",
      "read_only": 1
    },
    {
      "fieldname": "journal_entry",
      "label": "Journal Entry",
      "fieldtype": "Link",
      "options": "Journal Entry",
