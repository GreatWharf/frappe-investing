      "reqd": 1
    },
    {
      "fieldname": "source_ref",
      "label": "Source Ref",
      "fieldtype": "Data"
    },
    {
      "fieldname": "dedupe_key",
      "label": "Dedupe Key",
      "fieldtype": "Data",
