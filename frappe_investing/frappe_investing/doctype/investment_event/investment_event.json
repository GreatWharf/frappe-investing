    },
    {
      "fieldname": "amount",
      "label": "Amount",
      "fieldtype": "Data"
    },
    {
      "fieldname": "gross",
      "label": "Gross",
      "fieldtype": "Data"
    },
    {
      "fieldname": "fees",
      "label": "Fees",
      "fieldtype": "Data"
    },
    {
      "fieldname": "taxes",
      "label": "Taxes",
      "fieldtype": "Data"
    },
    {
      "fieldname": "accrued_interest",
      "label": "Accrued Interest",
      "fieldtype": "Data"
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "reqd": 1
    },
    {
      "fieldname": "corporate_action",
      "label": "Corporate Action",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "split_ratio",
      "label": "Split Ratio",
      "fieldtype": "Data"
    },
    {
      "fieldname": "basis_allocation",
      "label": "Basis Allocation",
      "fieldtype": "Data"
    },
    {
      "fieldname": "child_ratio",
      "label": "Child Ratio",
      "fieldtype": "Data"
    },
    {
      "fieldname": "child_security",
      "label": "Child Security",
      "fieldtype": "Link",
      "options": "Security"
    },
    {
