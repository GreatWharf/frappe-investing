{
  "doctype": "DocType",
  "name": "Security",
  "module": "Investing",
  "autoname": "hash",
  "engine": "InnoDB",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 0,
  "fields": [
    {
      "fieldname": "security_name",
      "label": "Security Name",
