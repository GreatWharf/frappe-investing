{
  "doctype": "DocType",
  "name": "Broker Connection",
  "module": "Investing",
  "autoname": "hash",
  "engine": "InnoDB",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 0,
  "fields": [
    {
