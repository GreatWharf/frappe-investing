      "write": 1
    },
    {
      "role": "Investment Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "delete": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "create": 1,
      "write": 1,
      "delete": 1
    }
  ],
  "track_changes": 0,
  "sort_field": "creation",
  "sort_order": "DESC",
